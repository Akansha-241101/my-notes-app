# Pooled Postgres URL — used only by `bun run db:setup` (never expose with VITE_).
DATABASE_URL=

# HTTPS Neon database URL for the browser client (from Neon Console → Data API).
# Example: https://ep-your-endpoint.c-4.ap-southeast-1.aws.neon.tech/neondb
# Not the postgresql:// connection string.
VITE_NEON_DATABASE_URL=
